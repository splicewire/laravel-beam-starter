# The transformer's own hash manifest of what it just emitted — a build cache, not a registry.
# aliases.ts and routes.ts above it ARE committed (ADR 0218 names routes.ts a committed registry);
# these per-vendor type directories are not, and were the only ones left neither tracked nor ignored.
/resources/js/generated/typescript-transformer-manifest.json
/vendor
.DS_Store
.env
.env.backup
.env.production
