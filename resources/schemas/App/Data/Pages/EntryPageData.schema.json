{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "EntryPageData",
    "properties": {
        "entry": {
            "anyOf": [
                {
                    "$ref": "#/$defs/PageEntryData"
                },
                {
                    "type": "null"
                }
            ]
        }
    },
    "required": [
        "entry"
    ],
    "$id": "EntryPageData",
    "$defs": {
        "PageEntryArtifactData": {
            "type": "object",
            "title": "PageEntryArtifactData",
            "properties": {
                "url": {
                    "type": "string"
                },
                "version": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "url",
                "version"
            ]
        },
        "PageEntryData": {
            "type": "object",
            "title": "PageEntryData",
            "properties": {
                "id": {
                    "type": "string"
                },
                "slug": {
                    "type": "string"
                },
                "format": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "artifact": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/PageEntryArtifactData"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "id",
                "slug",
                "format",
                "artifact"
            ]
        }
    }
}