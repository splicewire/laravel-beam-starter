{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "AuthEntryPageData",
    "properties": {
        "slug": {
            "type": "string"
        },
        "entry": {
            "anyOf": [
                {
                    "$ref": "#/$defs/PageEntryData"
                },
                {
                    "type": "null"
                }
            ]
        },
        "body": {
            "type": [
                "array",
                "null"
            ],
            "items": {
                "type": "object"
            }
        },
        "canResetPassword": {
            "type": "boolean",
            "x-optional": true
        },
        "status": {
            "type": [
                "string",
                "null"
            ],
            "x-optional": true
        },
        "demoAccounts": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/DemoAccountLinkData"
            },
            "x-optional": true
        },
        "passwordRules": {
            "type": "string",
            "x-optional": true
        }
    },
    "required": [
        "slug",
        "entry",
        "body"
    ],
    "$id": "AuthEntryPageData",
    "$defs": {
        "PageEntryData": {
            "type": "object",
            "title": "PageEntryData",
            "properties": {
                "id": {
                    "type": "string"
                },
                "slug": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "slug"
            ]
        },
        "DemoAccountLinkData": {
            "type": "object",
            "title": "DemoAccountLinkData",
            "properties": {
                "key": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            },
            "required": [
                "key",
                "label",
                "url"
            ]
        }
    }
}