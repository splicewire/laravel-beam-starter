{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "SecurityPageData",
    "properties": {
        "canManageTwoFactor": {
            "type": "boolean"
        },
        "canManagePasskeys": {
            "type": "boolean"
        },
        "passkeys": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/SecurityPasskeyData"
            }
        },
        "passwordRules": {
            "type": "string"
        },
        "twoFactorEnabled": {
            "type": "boolean",
            "x-optional": true
        },
        "requiresConfirmation": {
            "type": "boolean",
            "x-optional": true
        }
    },
    "required": [
        "canManageTwoFactor",
        "canManagePasskeys",
        "passkeys",
        "passwordRules"
    ],
    "$id": "SecurityPageData",
    "$defs": {
        "SecurityPasskeyData": {
            "type": "object",
            "title": "SecurityPasskeyData",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "authenticator": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "created_at_diff": {
                    "type": "string"
                },
                "last_used_at_diff": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "id",
                "name",
                "authenticator",
                "created_at_diff",
                "last_used_at_diff"
            ]
        }
    }
}