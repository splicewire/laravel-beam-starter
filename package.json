{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "packageManager": "pnpm@9.15.3",
    "type": "module",
    "pnpm": {
        "overrides": {
            "@schemastud/blockdoc": "0.1.1",
            "@schemastud/chat": "0.1.0",
            "@schemastud/facets": "0.1.0",
            "@schemastud/frame": "0.1.0",
            "@schemastud/frame-remote": "0.1.0",
            "@schemastud/mainframe": "0.1.0",
            "@schemastud/nav": "0.1.0",
            "@schemastud/seam": "0.2.1",
            "@splicewire/beam-resources": "0.1.0"
        }
    },
    "scripts": {
        "build": "pnpm run types:check && vite build",
        "build:ssr": "pnpm run types:check && vite build && vite build --ssr",
        "dev": "composer types:generate && vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "composer types:generate && tsc --noEmit && tsc -p tsconfig.generated.json",
        "beam:verify-prototype-boundary": "beam-verify-prototype-boundary"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@mdx-js/mdx": "^3.1.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@inertiajs/core": "^3.0.0",
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@measured/puck": "^0.20.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.1.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@schemastud/frame": "0.1.0",
        "@schemastud/frame-remote": "0.1.0",
        "@schemastud/mainframe": "0.1.0",
        "@schemastud/nav": "0.1.0",
        "@schemastud/seam": "0.2.1",
        "@schemastud/ui": "0.1.0",
        "@splicewire/beam-mainframe": "0.1.0",
        "@splicewire/beam-ux": "0.1.0",
        "@splicewire/beam-ux-prototype": "0.1.0",
        "@tailwindcss/vite": "^4.1.11",
        "@tanstack/react-query": "^5.0.0",
        "@tanstack/react-table": "^8.20.5",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "ajv": "^8.12.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "globals": "^15.14.0",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^0.475.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-rnd": "^10.5.2",
        "react-router": "^7.0.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "^8.0.0",
        "@splicewire/beam-inertia": "^0.1.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "prototype": {
        "outDir": "public/build"
    }
}
